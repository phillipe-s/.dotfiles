# Font
font-size = 15
font-family = JetBrainsMono Nerd Font
font-thicken = true
font-thicken-strength = 128
adjust-cell-height = 15%

# Theme
theme = GitHub Dark Default 
# theme = tokyonight

# Window
macos-titlebar-style = hidden
#window-decoration = none
window-padding-balance = true
window-padding-x = 12, 0
# window-padding-y = 12, 1
window-padding-color = extend-always
background-opacity = 0.85
background-blur = true
background-opacity-cells = true

# Other
adjust-cursor-thickness = 1
mouse-hide-while-typing = true
window-save-state = always
shell-integration-features = true
macos-option-as-alt = true

# Send Ctrl+number as unambiguous CSI-u sequences. Ghostty does not currently
# encode these reliably when tmux requests xterm's modifyOtherKeys protocol.
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
